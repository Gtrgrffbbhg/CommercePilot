PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
DATA_SOURCE=demo
DEMO_SEED=42

# ── Optional: MongoDB connection (reserved for a future milestone) ──────────────
# MONGODB_URI=

# ── Optional: WooCommerce REST API credentials ─────────────────────────────────
# Set DATA_SOURCE=woocommerce to enable live store data.
# Obtain credentials from: WooCommerce → Settings → Advanced → REST API → Add Key
#
# For local HTTP stores (http://), the client automatically uses query-string
# authentication because many local web servers strip the Authorization header.
# For production HTTPS stores, standard Basic Auth headers are used instead.
#
WOOCOMMERCE_STORE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
